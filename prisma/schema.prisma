datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  iin           String         @unique
  phone_number  String         @unique
  full_name     String
  birth_date    DateTime
  gender        String         // 'male' | 'female'
  role          String         @default("client") // 'client' | 'admin'
  is_blocked    Boolean        @default(false)
  is_banned     Boolean        @default(false)
  banned_until  DateTime?
  password_hash String
  email         String?
  avatar_url    String?
  created_at    DateTime       @default(now())

  hostedBookings Booking[]     @relation("HostBookings")
  bookingGuests  BookingGuest[]
  lockLogs       LockLog[]
  userBans       UserBan[]

  @@map("users")
}

model Ground {
  id                    String     @id @default(uuid())
  name                  String
  type                  String     // 'football' | 'volleyball' | 'basketball'
  address               String
  operating_schedule    String     // e.g. "08:00 - 23:00"
  cost_per_hour         Float
  latitude              Float      @default(43.238949)
  longitude             Float      @default(76.889709)
  allowed_radius_meters Int        @default(50)
  qr_code_token         String     @unique
  ttlock_lock_id        String
  ttlock_mac_address    String?
  is_school_court       Boolean    @default(true)
  school_hours_start    String     @default("08:00")
  school_hours_end      String     @default("15:00")
  school_days           String     @default("MON_FRI")
  created_at            DateTime   @default(now())

  gateways   Gateway[]
  bookings   Booking[]
  lockLogs   LockLog[]
  dailyStats VenueDailyStats[]
  userBans   UserBan[]

  @@index([ttlock_lock_id])
  @@map("grounds")
}

model Gateway {
  id                String   @id @default(uuid())
  ground_id         String
  ground            Ground   @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  gateway_name      String
  ttlock_gateway_id String   @unique
  status            String   @default("online") // 'online' | 'offline'
  last_ping_at      DateTime @default(now())
  created_at        DateTime @default(now())

  logs GatewayStatusLog[]

  @@map("gateways")
}

model Booking {
  id                     String         @id @default(uuid())
  ground_id              String
  ground                 Ground         @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  host_user_id           String
  host_user              User           @relation("HostBookings", fields: [host_user_id], references: [id], onDelete: Cascade)
  booking_date           String         // 'YYYY-MM-DD'
  start_time             String         // 'HH:mm'
  end_time               String         // 'HH:mm'
  status                 String         @default("confirmed") // 'pending' | 'confirmed' | 'cancelled' | 'cancelled_no_show' | 'completed'
  payment_status         String         @default("paid") // 'unpaid' | 'paid' | 'refunded'
  is_door_opened         Boolean        @default(false)
  total_price            Float
  invite_token           String         @unique @default(uuid())
  is_looking_for_players Boolean        @default(false)
  needed_players_count   Int            @default(0)
  auto_approve_players   Boolean        @default(false)
  created_at             DateTime       @default(now())

  guests       BookingGuest[]
  lockLogs     LockLog[]
  joinRequests JoinRequest[]

  @@index([booking_date, status, ground_id])
  @@index([host_user_id])
  @@index([is_looking_for_players, status])
  @@map("bookings")
}

model BookingGuest {
  id            String   @id @default(uuid())
  booking_id    String
  booking       Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type          String   // 'invited' | 'spontaneous_check_in'
  status        String   @default("approved") // 'approved' | 'pending'
  checked_in_at DateTime @default(now())
  created_at    DateTime @default(now())

  @@unique([booking_id, user_id])
  @@index([user_id])
  @@map("booking_guests")
}

model LockLog {
  id          String   @id @default(uuid())
  booking_id  String?
  booking     Booking? @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ground_id   String
  ground      Ground   @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  method      String   // 'app_button' | 'qr_code'
  unlock_type String   // 'online_cloud' | 'offline_passcode' | 'offline_ekey'
  success     Boolean
  details     String?
  created_at  DateTime @default(now())

  @@index([ground_id, created_at])
  @@index([user_id])
  @@index([booking_id])
  @@map("lock_logs")
}

model GatewayStatusLog {
  id           String   @id @default(uuid())
  gateway_id   String
  gateway      Gateway  @relation(fields: [gateway_id], references: [id], onDelete: Cascade)
  status       String   // 'online' | 'offline'
  response_raw String?
  checked_at   DateTime @default(now())

  @@map("gateway_status_logs")
}

model JoinRequest {
  id         String   @id @default(uuid())
  booking_id String
  booking    Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  user_iin   String
  user_name  String
  user_phone String
  status     String   @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  created_at DateTime @default(now())

  @@index([booking_id, status])
  @@index([user_iin])
  @@map("join_requests")
}

model VenueDailyStats {
  id                   String   @id @default(uuid())
  ground_id            String
  ground               Ground   @relation(fields: [ground_id], references: [id], onDelete: Cascade)
  date                 String   // 'YYYY-MM-DD'
  total_bookings       Int      @default(0)
  unique_players_count Int      @default(0)
  peak_hours_occupancy Float    @default(0.0)
  off_peak_occupancy   Float    @default(0.0)
  average_team_size    Float    @default(0.0)
  created_at           DateTime @default(now())

  @@unique([ground_id, date])
  @@map("venue_daily_stats")
}

model UserBan {
  id           String    @id @default(uuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ground_id    String?
  ground       Ground?   @relation(fields: [ground_id], references: [id], onDelete: SetNull)
  reason       String
  banned_until DateTime
  is_resolved  Boolean   @default(false)
  created_at   DateTime  @default(now())

  @@index([user_id, is_resolved, banned_until])
  @@index([ground_id])
  @@map("user_bans")
}
